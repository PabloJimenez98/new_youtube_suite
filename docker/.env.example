# Copy to docker/.env (git-ignored) and fill in. Read by docker/compose.yml.

# Log-in for the web app at http://localhost:4200
OPERATOR_EMAIL=examiner@example.com
OPERATOR_PASSWORD=examiner
JWT_SECRET=change-me-examiner
WEB_PORT=4200

# Speaker diarization (pyannote community-1) is a gated Hugging Face model:
# accept its terms at https://huggingface.co/pyannote/speaker-diarization-community-1,
# then create a read token at https://huggingface.co/settings/tokens. Without it, every tool
# works except diarization (transcripts have no speaker labels).
HF_TOKEN=

# GPU mode only: Qwen3.5-9B-Q4_K_M.gguf (5.7 GB, not part of this project). Empty = the file the
# project used, unsloth/Qwen3.5-9B-GGUF on Hugging Face (SHA-256 03b74727…b7e8, checked 2026-11-22).
QWEN_GGUF_URL=

# Optional: YouTube Data API v3 key for the market-analysis pipeline (see DELIVERY.md).
YOUTUBE_API_KEY=
