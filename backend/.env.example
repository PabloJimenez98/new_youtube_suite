# Copy to .env and adjust for local development. Never commit the real .env.
DATABASE_URL=postgresql+asyncpg://youtube_suite:youtube_suite@localhost:5432/youtube_suite
TEST_DATABASE_URL=postgresql+asyncpg://youtube_suite:youtube_suite@localhost:5432/youtube_suite_test

# Symmetric secret used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Base directory where uploaded files are written (local StorageBackend).
STORAGE_BASE_PATH=../uploads

# arq job queue broker (M2). Separate logical Redis DB for tests.
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1
