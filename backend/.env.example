# Copy to .env and adjust for local development. Never commit the real .env.
DATABASE_URL=postgresql+asyncpg://youtube_suite:youtube_suite@localhost:5432/youtube_suite
TEST_DATABASE_URL=postgresql+asyncpg://youtube_suite:youtube_suite@localhost:5432/youtube_suite_test

# Symmetric secret used to sign JWT access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-dev-only
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Base directory where uploaded files are written (local StorageBackend).
STORAGE_BASE_PATH=../uploads

# arq job queue broker (M2). Separate logical Redis DB for tests.
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Transcription (M3). Values for a 12 GB RTX 50xx (docs/decisions/0016).
# No GPU: WHISPER_DEVICE=cpu and WHISPER_COMPUTE_TYPE=int8. See 0007.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16
# Batched greedy decoding (M9, docs/decisions/0014); WHISPER_BATCH_SIZE=0 for sequential.
WHISPER_BEAM_SIZE=1
WHISPER_BATCH_SIZE=16
WORKER_JOB_TIMEOUT_SECONDS=10800

# Speaker diarization (M4). Read token for the gated
# pyannote/speaker-diarization-community-1 model -- see README.
HF_TOKEN=
DIARIZATION_DEVICE=cuda
DIARIZATION_EMBEDDING_BATCH_SIZE=32
DIARIZATION_HEALTHCHECK=true

# Chapter generation (M5). Path to a model bundle exported by
# experiments/m5-chapters/05_eval.ipynb (not in git).
# See docs/decisions/0009-chapter-generator-local-models.md, 0010 and 0016.
CHAPTERS_MODEL_DIR=models/chapters/current
CHAPTERS_DEVICE=cuda
# Shared LLM (chapter titles, show notes, relevance): CPU threads and
# layers on the GPU (-1 = all; 0 = weights in RAM, M9 behaviour). 0016.
CHAPTERS_LLM_THREADS=8
LLM_N_GPU_LAYERS=-1

# Shorts (M8): YuNet face detector for the vertical crop (see README, "Shorts").
SHORTS_FACE_MODEL_PATH=models/shorts/face_detection_yunet_2023mar.onnx

# Market pipeline (M10): read-only key with YouTube Data API v3 enabled.
# Leave unset/empty -> the market cron tasks log a skip. See docs/decisions/0015.
YOUTUBE_API_KEY=
MARKET_RECENT_WINDOW_DAYS=90
MARKET_OLDER_INTERVAL_DAYS=7
MARKET_DAILY_UNIT_BUDGET=5000
